{
  "name": "quick-tool",
  "version": "0.1.0",
  "description": "Curated case: custom query tool with a result card (tool + tool-view)",
  "type": "module",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-renderer": "__DSH_VERSION__",
    "@deepseek-ai/dsh-client-ui-slots": "__DSH_VERSION__",
    "@deepseek-ai/dsh-client-ui-tool": "__DSH_VERSION__",
    "@deepseek-ai/dsh-tools": "__DSH_VERSION__"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.0",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.0"
  }
}
